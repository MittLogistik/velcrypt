    "Drawing it on the lock screen opens this vault and permanently deletes every other vault on this iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibujarlo en la pantalla de bloqueo abre esta bóveda y elimina de forma permanente todas las demás bóvedas de este iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du es auf dem Sperrbildschirm zeichnest, öffnet sich dieser Tresor und alle anderen Tresore auf diesem iPhone werden endgültig gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tracer sur l’écran de verrouillage ouvre ce coffre et supprime définitivement tous les autres coffres de cet iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhá-lo na tela de bloqueio abre este cofre e apaga permanentemente todos os outros cofres deste iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面で描くとこの保管庫が開き、このiPhone上のほかの保管庫はすべて完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면에서 그리면 이 금고가 열리고 이 iPhone의 다른 모든 금고가 영구적으로 삭제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在锁定屏幕上绘制它会打开此保险库，并永久删除此 iPhone 上的所有其他保险库。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracciarla nella schermata di blocco apre questa cassaforte ed elimina definitivamente tutte le altre casseforti su questo iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
