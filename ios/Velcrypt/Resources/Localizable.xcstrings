    "All vaults, for every pattern, will be permanently deleted and Velcrypt will start over." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las bóvedas, de todos los patrones, se eliminarán de forma permanente y Velcrypt empezará de cero."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Tresore aller Muster werden endgültig gelöscht und Velcrypt beginnt von vorn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les coffres, quel que soit le schéma, seront définitivement supprimés et Velcrypt repartira de zéro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os cofres, de todos os padrões, serão apagados permanentemente e o Velcrypt começará do zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのパターンのすべての保管庫が完全に削除され、Velcryptは最初からやり直しになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 패턴의 모든 금고가 영구적으로 삭제되며 Velcrypt가 처음부터 다시 시작됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有图案对应的全部保险库都将被永久删除，Velcrypt 将重新开始。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le casseforti, di ogni sequenza, verranno eliminate definitivamente e Velcrypt ripartirà da zero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle kluizen, van elk patroon, worden definitief verwijderd en Velcrypt begint opnieuw."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla valv, för alla mönster, raderas permanent och Velcrypt börjar om från början."
          }
        }
      }
    },
    "Allow Velcrypt to access Photos in Settings, or delete the originals in Photos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Velcrypt acceda a Fotos en Ajustes o elimina los originales en Fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Velcrypt in den Einstellungen den Zugriff auf „Fotos“ oder lösche die Originale in „Fotos“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Velcrypt à accéder à Photos dans Réglages, ou supprimez les originaux dans Photos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Velcrypt acesse o Fotos em Ajustes ou apague os originais no Fotos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」でVelcryptに写真へのアクセスを許可するか、「写真」でオリジナルを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Velcrypt의 사진 접근을 허용하거나 사진 앱에서 원본을 삭제하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许 Velcrypt 访问照片，或在“照片”中删除原件。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Velcrypt di accedere a Foto in Impostazioni oppure elimina gli originali in Foto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef Velcrypt in Instellingen toegang tot Foto's of verwijder de originelen in Foto's."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge Velcrypt åtkomst till Bilder i Inställningar, eller radera originalen i Bilder."
          }
        }
      }
    },
