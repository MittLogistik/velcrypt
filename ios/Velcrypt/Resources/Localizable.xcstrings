          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere diesen Tresor in einer verschlüsselten Datei oder stelle ein Backup auf einem neuen iPhone wieder her."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardez ce coffre dans un fichier chiffré ou restaurez une sauvegarde sur un nouvel iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
