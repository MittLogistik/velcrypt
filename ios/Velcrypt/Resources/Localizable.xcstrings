    "Long-press the original Velcrypt icon, tap “Remove App”, then “Remove from Home Screen”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el icono original de Velcrypt, toca “Eliminar app” y luego “Eliminar de la pantalla de inicio”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Finger auf das ursprüngliche Velcrypt-Symbol, tippe auf „App entfernen“ und dann auf „Vom Home-Bildschirm entfernen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur l’icône Velcrypt d’origine, touchez « Supprimer l’app », puis « Retirer de l’écran d’accueil »."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado o ícone original do Velcrypt, toque em “Remover App” e depois em “Remover da Tela de Início”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のVelcryptアイコンを長押しして、「Appを削除」、「ホーム画面から取り除く」の順にタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원래 Velcrypt 아이콘을 길게 누르고 ‘앱 제거’를 탭한 다음 ‘홈 화면에서 제거’를 탭하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住原来的 Velcrypt 图标，轻点“移除 App”，然后轻点“从主屏幕移除”。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta l’icona originale di Velcrypt, tocca “Rimuovi app”, poi “Rimuovi da Home”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het oorspronkelijke Velcrypt-symbool ingedrukt, tik op 'Verwijder app' en vervolgens op 'Verwijder van beginscherm'."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll fingret på den ursprungliga Velcrypt-symbolen, tryck på ”Ta bort app” och sedan på ”Ta bort från hemskärmen”."
          }
        }
      }
    },
    "Long-press the Velcrypt icon." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el icono de Velcrypt."
          }
        },
        "de" : {
          "stringUnit" : {
