          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nello stesso momento, tutte le altre casseforti su questo iPhone vengono eliminate definitivamente. Sullo schermo non appare nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
