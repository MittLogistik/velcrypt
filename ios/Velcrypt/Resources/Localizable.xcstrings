    "The backup's items are added to the vault you have open. Nothing is deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos de la copia se añaden a la bóveda que tienes abierta. No se elimina nada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Objekte aus dem Backup werden dem geöffneten Tresor hinzugefügt. Es wird nichts gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments de la sauvegarde sont ajoutés au coffre ouvert. Rien n’est supprimé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens do backup são adicionados ao cofre que está aberto. Nada é apagado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの項目は、開いている保管庫に追加されます。削除されるものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업의 항목이 현재 열려 있는 금고에 추가됩니다. 아무것도 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份中的项目会添加到当前打开的保险库。不会删除任何内容。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi del backup vengono aggiunti alla cassaforte aperta. Non viene eliminato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De onderdelen uit de back-up worden toegevoegd aan de kluis die je open hebt. Er wordt niets verwijderd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
