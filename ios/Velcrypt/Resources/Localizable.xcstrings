    "Velcrypt can't recover a forgotten backup password. Without it, the backup can't be opened." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt no puede recuperar una contraseña de copia de seguridad olvidada. Sin ella, la copia no se puede abrir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt kann ein vergessenes Backup-Passwort nicht wiederherstellen. Ohne es lässt sich das Backup nicht öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt ne peut pas récupérer un mot de passe de sauvegarde oublié. Sans lui, la sauvegarde ne peut pas être ouverte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Velcrypt não consegue recuperar uma senha de backup esquecida. Sem ela, o backup não pode ser aberto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcryptは忘れたバックアップパスワードを復元できません。パスワードがないとバックアップを開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt는 잊어버린 백업 암호를 복구할 수 없습니다. 암호가 없으면 백업을 열 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt 无法找回忘记的备份密码。没有密码，就无法打开备份。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt non può recuperare una password di backup dimenticata. Senza di essa, il backup non può essere aperto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt kan een vergeten back-upwachtwoord niet herstellen. Zonder dat wachtwoord kan de back-up niet worden geopend."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt kan inte återskapa ett glömt lösenord för säkerhetskopian. Utan det går säkerhetskopian inte att öppna."
          }
        }
      }
    },
    "Restoring Adds Items" : {
