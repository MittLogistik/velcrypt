    "This backup was made by a newer version of Velcrypt. Update the app and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad se creó con una versión más reciente de Velcrypt. Actualiza la app e inténtalo de nuevo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup wurde mit einer neueren Version von Velcrypt erstellt. Aktualisiere die App und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde a été créée par une version plus récente de Velcrypt. Mettez l’app à jour et réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup foi criado por uma versão mais recente do Velcrypt. Atualize o app e tente novamente."
