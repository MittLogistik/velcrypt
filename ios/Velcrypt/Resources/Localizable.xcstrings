          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível restaurar o backup. O arquivo pode estar danificado ou incompleto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップを復元できませんでした。ファイルが破損しているか、不完全な可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업을 복원할 수 없습니다. 파일이 손상되었거나 불완전할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法恢复备份。文件可能已损坏或不完整。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile ripristinare il backup. Il file potrebbe essere danneggiato o incompleto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-up kon niet worden teruggezet. Het bestand is mogelijk beschadigd of onvolledig."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopian kunde inte återställas. Filen kan vara skadad eller ofullständig."
          }
        }
      }
    },
    "Back up this vault to an encrypted file, or restore a backup on a new iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
