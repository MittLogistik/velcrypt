    "Practise it in your head, not on the lock screen: drawing it deletes your other vaults." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practícalo mentalmente, no en la pantalla de bloqueo: dibujarlo elimina tus otras bóvedas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übe es im Kopf, nicht auf dem Sperrbildschirm: Wenn du es zeichnest, werden deine anderen Tresore gelöscht."
