    "Your purchase is waiting for approval. Premium unlocks as soon as it's approved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra está pendiente de aprobación. Premium se desbloqueará en cuanto se apruebe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf wartet auf Genehmigung. Premium wird freigeschaltet, sobald er genehmigt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre achat est en attente d’approbation. Premium sera débloqué dès son approbation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua compra está aguardando aprovação. O Premium será liberado assim que for aprovada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入は承認待ちです。承認されるとすぐにプレミアムが有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구입이 승인 대기 중입니다. 승인되는 즉시 프리미엄이 활성화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的购买正在等待批准。批准后将立即解锁高级版。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo acquisto è in attesa di approvazione. Premium si sbloccherà non appena verrà approvato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je aankoop wacht op goedkeuring. Premium wordt ontgrendeld zodra deze is goedgekeurd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt köp väntar på godkännande. Premium låses upp så snart det har godkänts."
          }
        }
      }
    },
