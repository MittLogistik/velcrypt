    },
    "The backup's items are added to the vault you have open now. Nothing in this vault is deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos de la copia se añaden a la bóveda que tienes abierta ahora. No se elimina nada de esta bóveda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Objekte aus dem Backup werden dem gerade geöffneten Tresor hinzugefügt. In diesem Tresor wird nichts gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments de la sauvegarde sont ajoutés au coffre actuellement ouvert. Rien n’est supprimé de ce coffre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens do backup são adicionados ao cofre aberto agora. Nada neste cofre é apagado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの項目は、現在開いている保管庫に追加されます。この保管庫から削除されるものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업의 항목이 지금 열려 있는 금고에 추가됩니다. 이 금고에서 삭제되는 것은 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份中的项目会添加到当前打开的保险库。此保险库中的内容不会被删除。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi del backup vengono aggiunti alla cassaforte aperta ora. In questa cassaforte non viene eliminato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De onderdelen uit de back-up worden toegevoegd aan de kluis die je nu open hebt. Er wordt niets uit deze kluis verwijderd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekten i säkerhetskopian läggs till i valvet som är öppet nu. Inget i det här valvet raderas."
          }
        }
      }
    },
