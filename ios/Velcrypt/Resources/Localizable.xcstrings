    "Vault data stays on this iPhone and is not included in iCloud or computer backups." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de la bóveda se quedan en este iPhone y no se incluyen en las copias de seguridad de iCloud ni del ordenador."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tresordaten bleiben auf diesem iPhone und sind nicht in iCloud- oder Computer-Backups enthalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du coffre restent sur cet iPhone et ne sont pas incluses dans les sauvegardes iCloud ou sur ordinateur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do cofre ficam neste iPhone e não são incluídos nos backups do iCloud nem do computador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫のデータはこのiPhoneに保存され、iCloudやコンピュータのバックアップには含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금고 데이터는 이 iPhone에만 보관되며 iCloud 또는 컴퓨터 백업에 포함되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保险库数据保留在此 iPhone 上，不会包含在 iCloud 或电脑备份中。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati della cassaforte restano su questo iPhone e non sono inclusi nei backup di iCloud o del computer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kluisgegevens blijven op deze iPhone en worden niet opgenomen in iCloud- of computerback-ups."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valvdata stannar på den här iPhonen och ingår inte i säkerhetskopior till iCloud eller dator."
          }
        }
      }
    },
    "Vault protected" : {
      "localizations" : {
