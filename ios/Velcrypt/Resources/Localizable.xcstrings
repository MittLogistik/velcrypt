    "Tap “Require Face ID”, then “Hide and Require Face ID”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca “Requerir Face ID” y luego “Ocultar y requerir Face ID”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Face ID erforderlich“ und dann auf „Ausblenden und Face ID erforderlich“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Exiger Face ID », puis « Masquer et exiger Face ID »."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em “Exigir Face ID” e depois em “Ocultar e Exigir Face ID”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Face IDを必要にする」をタップしてから、「非表示にしてFace IDを必要にする」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Face ID 필요’를 탭한 다음 ‘숨기기 및 Face ID 필요’를 탭하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“需要面容 ID”，然后轻点“隐藏并需要面容 ID”。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca “Richiedi Face ID”, poi “Nascondi e richiedi Face ID”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op 'Vereis Face ID' en vervolgens op 'Verberg en vereis Face ID'."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ”Kräv Face ID” och sedan på ”Göm och kräv Face ID”."
          }
        }
      }
    },
    "Tap + to add photos, videos or documents. They're encrypted as they're imported." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para añadir fotos, vídeos o documentos. Se cifran a medida que se importan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, um Fotos, Videos oder Dokumente hinzuzufügen. Sie werden beim Importieren verschlüsselt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour ajouter des photos, des vidéos ou des documents. Ils sont chiffrés pendant l’importation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + para adicionar fotos, vídeos ou documentos. Eles são criptografados durante a importação."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+をタップして写真、ビデオ、書類を追加します。読み込みと同時に暗号化されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+를 탭하여 사진, 비디오 또는 문서를 추가하세요. 가져오는 동안 암호화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点 + 添加照片、视频或文稿。它们会在导入时被加密。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + per aggiungere foto, video o documenti. Vengono cifrati durante l’importazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op + om foto's, video's of documenten toe te voegen. Ze worden tijdens het importeren versleuteld."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på + för att lägga till bilder, videor eller dokument. De krypteras när de importeras."
          }
        }
      }
    },
    "Tap + to import. Everything is encrypted before it's stored." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para importar. Todo se cifra antes de guardarse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zum Importieren auf +. Alles wird vor dem Speichern verschlüsselt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour importer. Tout est chiffré avant d’être stocké."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + para importar. Tudo é criptografado antes de ser armazenado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+をタップして読み込みます。すべて保存前に暗号化されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+를 탭하여 가져오세요. 모든 항목은 저장되기 전에 암호화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点 + 导入。所有内容在存储前都会加密。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + per importare. Tutto viene cifrato prima di essere archiviato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op + om te importeren. Alles wordt versleuteld voordat het wordt opgeslagen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på + för att importera. Allt krypteras innan det lagras."
          }
        }
      }
    },
    "Tap the share button, then “Add to Home Screen”. Choose any name and icon." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón Compartir y luego “Añadir a pantalla de inicio”. Elige el nombre y el icono que quieras."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Teilen-Taste und dann auf „Zum Home-Bildschirm“. Wähle einen beliebigen Namen und ein beliebiges Symbol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton Partager, puis « Sur l’écran d’accueil ». Choisissez le nom et l’icône de votre choix."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no botão Compartilhar e em “Adicionar à Tela de Início”. Escolha qualquer nome e ícone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有ボタンをタップして、「ホーム画面に追加」をタップします。名前とアイコンは自由に選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 버튼을 탭한 다음 ‘홈 화면에 추가’를 탭하세요. 이름과 아이콘은 자유롭게 선택할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点共享按钮，然后轻点“添加到主屏幕”。名称和图标可任意选择。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante Condividi, poi “Aggiungi alla schermata Home”. Scegli il nome e l’icona che preferisci."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de deelknop en vervolgens op 'Zet op beginscherm'. Kies een willekeurige naam en een symbool."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på delningsknappen och sedan på ”Lägg till på hemskärmen”. Välj valfritt namn och symbol."
          }
        }
      }
    },
