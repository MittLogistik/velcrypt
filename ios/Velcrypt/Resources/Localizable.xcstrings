    "Vaults are not included in iCloud or computer backups. If you lose or reset this device, the vaults are lost too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bóvedas no se incluyen en las copias de seguridad de iCloud ni del ordenador. Si pierdes o restableces este dispositivo, también perderás las bóvedas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tresore sind nicht in iCloud- oder Computer-Backups enthalten. Wenn du dieses Gerät verlierst oder zurücksetzt, gehen auch die Tresore verloren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coffres ne sont pas inclus dans les sauvegardes iCloud ou sur ordinateur. Si vous perdez ou réinitialisez cet appareil, les coffres sont perdus eux aussi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cofres não são incluídos nos backups do iCloud nem do computador. Se você perder ou redefinir este dispositivo, os cofres também serão perdidos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫はiCloudやコンピュータのバックアップに含まれません。このデバイスを紛失したりリセットしたりすると、保管庫も失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금고는 iCloud 또는 컴퓨터 백업에 포함되지 않습니다. 이 기기를 분실하거나 재설정하면 금고도 함께 사라집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保险库不会包含在 iCloud 或电脑备份中。如果你丢失或还原此设备，保险库也会随之丢失。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le casseforti non sono incluse nei backup di iCloud o del computer. Se perdi o ripristini questo dispositivo, perdi anche le casseforti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kluizen worden niet opgenomen in iCloud- of computerback-ups. Als je dit apparaat kwijtraakt of herstelt, ben je ook de kluizen kwijt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valv ingår inte i säkerhetskopior till iCloud eller dator. Om du tappar bort eller återställer enheten förloras även valven."
          }
        }
      }
    },
    "Velcrypt couldn't reach these items. You can delete them in Photos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt no ha podido acceder a estos elementos. Puedes eliminarlos en Fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt konnte nicht auf diese Objekte zugreifen. Du kannst sie in „Fotos“ löschen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt n’a pas pu accéder à ces éléments. Vous pouvez les supprimer dans Photos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Velcrypt não conseguiu acessar estes itens. Você pode apagá-los no Fotos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcryptはこれらの項目にアクセスできませんでした。「写真」で削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt가 이 항목에 접근할 수 없습니다. 사진 앱에서 삭제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt 无法访问这些项目。你可以在“照片”中删除它们。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt non è riuscito ad accedere a questi elementi. Puoi eliminarli in Foto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt kon deze onderdelen niet bereiken. Je kunt ze verwijderen in Foto's."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt kunde inte nå objekten. Du kan radera dem i Bilder."
          }
        }
      }
    },
    "Velcrypt imports encrypted copies. Your originals stay where they are until you delete them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt importa copias cifradas. Tus originales se quedan donde están hasta que los elimines."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt importiert verschlüsselte Kopien. Deine Originale bleiben, wo sie sind, bis du sie löschst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt importe des copies chiffrées. Vos originaux restent en place jusqu’à ce que vous les supprimiez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Velcrypt importa cópias criptografadas. Seus originais ficam onde estão até que você os apague."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcryptは暗号化したコピーを読み込みます。オリジナルは、あなたが削除するまで元の場所に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt는 암호화된 사본을 가져옵니다. 원본은 직접 삭제할 때까지 원래 위치에 그대로 남아 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt 导入的是加密副本。原件会保留在原处，直到你将其删除。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt importa copie cifrate. Gli originali restano dove sono finché non li elimini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt importeert versleutelde kopieën. Je originelen blijven waar ze zijn tot je ze verwijdert."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt importerar krypterade kopior. Originalen stannar där de är tills du raderar dem."
          }
        }
      }
    },
    "Velcrypt keeps your most personal photos, videos and documents in encrypted vaults that only you can open." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt guarda tus fotos, vídeos y documentos más personales en bóvedas cifradas que solo tú puedes abrir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt bewahrt deine persönlichsten Fotos, Videos und Dokumente in verschlüsselten Tresoren auf, die nur du öffnen kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt conserve vos photos, vidéos et documents les plus personnels dans des coffres chiffrés que vous seul pouvez ouvrir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Velcrypt guarda suas fotos, vídeos e documentos mais pessoais em cofres criptografados que só você pode abrir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcryptは、あなたの大切な写真、ビデオ、書類を、あなたにしか開けない暗号化された保管庫にしまっておきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt는 가장 개인적인 사진, 비디오, 문서를 오직 당신만 열 수 있는 암호화된 금고에 보관합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt 将你最私密的照片、视频和文稿保存在只有你能打开的加密保险库中。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt conserva le tue foto, i video e i documenti più personali in casseforti cifrate che solo tu puoi aprire."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt bewaart je meest persoonlijke foto's, video's en documenten in versleutelde kluizen die alleen jij kunt openen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt förvarar dina mest personliga bilder, videor och dokument i krypterade valv som bara du kan öppna."
          }
        }
      }
    },
    "Velcrypt stays installed and can still be found in the App Library." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
