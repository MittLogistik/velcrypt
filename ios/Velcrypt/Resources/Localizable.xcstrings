    "Each vault is backed up on its own, so a backup never reveals your other vaults." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada bóveda se respalda por separado, así que una copia de seguridad nunca revela tus otras bóvedas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tresor wird einzeln gesichert, sodass ein Backup deine anderen Tresore nie verrät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque coffre est sauvegardé séparément : une sauvegarde ne révèle jamais vos autres coffres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cofre tem seu próprio backup, então um backup nunca revela seus outros cofres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫ごとに個別にバックアップされるため、バックアップから他の保管庫の存在が知られることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금고마다 따로 백업되므로 백업으로 다른 금고의 존재가 드러나지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个保险库单独备份，因此备份绝不会暴露你的其他保险库。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cassaforte viene salvata separatamente, quindi un backup non rivela mai le tue altre casseforti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke kluis krijgt een eigen back-up, dus een back-up verraadt nooit je andere kluizen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje valv säkerhetskopieras för sig, så en säkerhetskopia avslöjar aldrig dina andra valv."
          }
        }
      }
    },
    "Your Password Only" : {
      "localizations" : {
