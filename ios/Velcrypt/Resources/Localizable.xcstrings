    "Velcrypt can't recover this password. Without it, the backup can't be opened." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt no puede recuperar esta contraseña. Sin ella, la copia de seguridad no se puede abrir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt kann dieses Passwort nicht wiederherstellen. Ohne es lässt sich das Backup nicht öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt ne peut pas récupérer ce mot de passe. Sans lui, la sauvegarde ne peut pas être ouverte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Velcrypt não consegue recuperar esta senha. Sem ela, o backup não pode ser aberto."
