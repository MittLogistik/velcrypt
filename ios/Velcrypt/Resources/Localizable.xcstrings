    "Group photos, videos and documents into albums. Albums exist only inside this vault." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa fotos, vídeos y documentos en álbumes. Los álbumes solo existen dentro de esta bóveda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordne Fotos, Videos und Dokumente in Alben. Alben gibt es nur in diesem Tresor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupez photos, vidéos et documents dans des albums. Les albums n’existent que dans ce coffre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupe fotos, vídeos e documentos em álbuns. Os álbuns existem apenas dentro deste cofre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真、ビデオ、書類をアルバムに整理できます。アルバムはこの保管庫の中にだけ存在します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진, 비디오, 문서를 앨범으로 정리하세요. 앨범은 이 금고 안에만 존재합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将照片、视频和文稿整理到相簿中。相簿仅存在于此保险库内。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggruppa foto, video e documenti in album. Gli album esistono solo all’interno di questa cassaforte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groepeer foto's, video's en documenten in albums. Albums bestaan alleen in deze kluis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samla bilder, videor och dokument i album. Albumen finns bara i det här valvet."
          }
        }
      }
    },
    "Hidden apps move to the Hidden folder at the bottom of the App Library." : {
      "localizations" : {
        "es" : {
