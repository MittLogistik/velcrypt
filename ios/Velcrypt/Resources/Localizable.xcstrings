  "strings" : {
    "“Delete Album Only” keeps the items in your vault." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Eliminar solo el álbum” conserva los elementos en tu bóveda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nur Album löschen“ behält die Objekte in deinem Tresor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Supprimer l’album uniquement » conserve les éléments dans votre coffre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Apagar Somente o Álbum” mantém os itens no seu cofre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アルバムのみを削除」を選ぶと、項目は保管庫に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘앨범만 삭제’를 선택하면 항목은 금고에 그대로 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“仅删除相簿”会将项目保留在保险库中。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Elimina solo album” mantiene gli elementi nella cassaforte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met 'Verwijder alleen album' blijven de onderdelen in je kluis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Radera endast album” behåller objekten i ditt valv."
          }
        }
      }
    },
