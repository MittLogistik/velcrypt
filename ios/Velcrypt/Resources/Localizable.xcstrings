        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急用パターンは、設定した保管庫を開きます。この保管庫には当たり障りのない写真を入れておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비상 패턴은 설정한 금고를 엽니다. 이 금고에는 무해한 사진을 넣어 두세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胁迫图案会打开你设置它时所在的保险库，所以请在这里放一些无关紧要的照片。"
