    "Deleted items are removed from the vault permanently." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos eliminados se borran de la bóveda de forma permanente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Objekte werden endgültig aus dem Tresor entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments supprimés sont définitivement retirés du coffre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens apagados são removidos do cofre permanentemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した項目は保管庫から完全に消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제한 항목은 금고에서 영구적으로 제거됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除的项目将从保险库中永久移除。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi eliminati vengono rimossi definitivamente dalla cassaforte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderde onderdelen worden definitief uit de kluis gehaald."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderade objekt tas bort permanent från valvet."
          }
        }
      }
    },
    "Deleting is permanent and cannot be undone. Originals in your Photos library are not affected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación es permanente y no se puede deshacer. Los originales de tu fototeca no se ven afectados."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen ist endgültig und kann nicht widerrufen werden. Originale in deiner Fotomediathek bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression est définitive et irréversible. Les originaux de votre photothèque ne sont pas touchés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar é permanente e não pode ser desfeito. Os originais na sua fototeca não são afetados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除は完全に行われ、取り消すことはできません。写真ライブラリ内のオリジナルには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제는 영구적이며 실행 취소할 수 없습니다. 사진 보관함에 있는 원본에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除是永久性的，无法撤销。照片图库中的原件不受影响。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eliminazione è definitiva e non può essere annullata. Gli originali nella libreria Foto non vengono toccati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderen is definitief en kan niet ongedaan worden gemaakt. Originelen in je fotobibliotheek blijven ongewijzigd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderingen är permanent och kan inte ångras. Original i ditt bildbibliotek påverkas inte."
          }
        }
      }
    },
