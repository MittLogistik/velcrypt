    "Fill a second vault with harmless photos. If you're ever pressured to open the app, show that one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llena una segunda bóveda con fotos inofensivas. Si alguna vez te presionan para abrir la app, muestra esa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fülle einen zweiten Tresor mit harmlosen Fotos. Falls dich jemand drängt, die App zu öffnen, zeig diesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplissez un second coffre de photos anodines. Si l’on vous pousse un jour à ouvrir l’app, montrez celui-là."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encha um segundo cofre com fotos inofensivas. Se algum dia pressionarem você a abrir o app, mostre esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つ目の保管庫に当たり障りのない写真を入れておきましょう。アプリを開くよう迫られたときは、そちらを見せればOKです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번째 금고에 무난한 사진을 채워 두세요. 앱을 열라는 압박을 받으면 그 금고를 보여 주면 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在第二个保险库中放一些无关紧要的照片。如果有人逼你打开 App，就给他看那一个。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riempi una seconda cassaforte con foto innocue. Se qualcuno ti costringe ad aprire l’app, mostra quella."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul een tweede kluis met onschuldige foto's. Word je ooit onder druk gezet om de app te openen, laat die dan zien."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyll ett andra valv med harmlösa bilder. Om någon pressar dig att öppna appen kan du visa det."
          }
        }
      }
    },
