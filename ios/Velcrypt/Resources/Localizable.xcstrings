    "Add photos, videos and documents. They're encrypted the moment they arrive." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade fotos, vídeos y documentos. Se cifran en cuanto llegan."
          }
        },
        "de" : {
          "stringUnit" : {
