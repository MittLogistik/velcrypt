    "The duress pattern opens the vault you set it up in, so fill this one with harmless photos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El patrón de coacción abre la bóveda en la que lo configuras, así que llénala de fotos inofensivas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Notfallmuster öffnet den Tresor, in dem du es einrichtest. Füll diesen also mit harmlosen Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schéma de contrainte ouvre le coffre dans lequel vous le configurez : remplissez celui-ci de photos anodines."
          }
