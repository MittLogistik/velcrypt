    "Connect at least 6 dots and change direction at least once. 8 or more dots is much stronger." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta al menos 6 puntos y cambia de dirección al menos una vez. Con 8 puntos o más es mucho más seguro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde mindestens 6 Punkte und ändere mindestens einmal die Richtung. Mit 8 oder mehr Punkten ist es deutlich sicherer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reliez au moins 6 points et changez de direction au moins une fois. Avec 8 points ou plus, c’est beaucoup plus sûr."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte pelo menos 6 pontos e mude de direção pelo menos uma vez. Com 8 pontos ou mais, fica muito mais seguro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6個以上のドットをつなぎ、少なくとも1回は方向を変えてください。8個以上にするとさらに強力になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점을 6개 이상 연결하고 방향을 한 번 이상 바꾸세요. 8개 이상이면 훨씬 더 안전합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少连接 6 个点，并至少改变一次方向。连接 8 个或更多点会安全得多。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega almeno 6 punti e cambia direzione almeno una volta. Con 8 punti o più è molto più sicura."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind minstens 6 stippen en verander minstens één keer van richting. Met 8 of meer stippen is het veel sterker."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppla ihop minst 6 punkter och byt riktning minst en gång. 8 punkter eller fler är mycket starkare."
          }
        }
      }
    },
