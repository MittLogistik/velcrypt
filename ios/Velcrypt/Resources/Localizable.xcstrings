            "value" : "Velcryptはインストールされたままで、Appライブラリから引き続き見つけられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt는 설치된 상태로 유지되며 앱 보관함에서 계속 찾을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt 仍保持安装，并且仍可在 App 资源库中找到。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt resta installata e si trova ancora nella Libreria app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt blijft geïnstalleerd en staat nog steeds in de appbibliotheek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt är fortfarande installerad och finns kvar i appbiblioteket."
          }
        }
      }
    },
