        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt는 이 암호를 복구할 수 없습니다. 암호가 없으면 백업을 열 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velcrypt 无法找回此密码。没有密码，就无法打开备份。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
