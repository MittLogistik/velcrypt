---
/** FAQ list with each question as a real heading (good for extraction). */
interface Props { items: { q: string; a: string }[]; heading?: string; level?: 2 | 3; id?: string }
const { items, heading, level = 2, id = 'faq' } = Astro.props;
const Q = level === 2 ? 'h3' : 'h4';
const H = level === 2 ? 'h2' : 'h3';
---
<section class="faq" id={id} aria-labelledby={heading ? `${id}-title` : undefined}>
  {heading && <H id={`${id}-title`}>{heading}</H>}
  <div class="items">
    {items.map((f) => (
      <div class="item">
        <Q>{f.q}</Q>
        <p>{f.a}</p>
      </div>
    ))}
  </div>
</section>
<style>
  .faq { margin: 56px 0 0; max-width: var(--prose); }
  .items { border-top: 1px solid var(--line); }
  .item { padding: 20px 0; border-bottom: 1px solid var(--line); }
  .item :is(h3, h4) { font-size: 1.08rem; margin: 0 0 8px; letter-spacing: -0.01em; }
  .item p { margin: 0; color: #cdd6e3; }
</style>
