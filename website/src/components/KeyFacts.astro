---
interface Props { answer: string; facts: string[]; label?: string; answerLabel?: string }
const { answer, facts, label = 'Key facts', answerLabel = 'In short' } = Astro.props;
---
<aside class="tldr" aria-label={label}>
  <p class="answer"><strong>{answerLabel}:</strong> {answer}</p>
  <h2 class="kf">{label}</h2>
  <ul>{facts.map((f) => <li>{f}</li>)}</ul>
</aside>
<style>
  .tldr {
    max-width: var(--prose); margin: 8px 0 40px; padding: 22px 24px;
    border-radius: var(--radius); border: 1px solid rgba(79, 140, 255, 0.35);
    background: radial-gradient(120% 140% at 0% 0%, rgba(79, 140, 255, 0.14), transparent 60%), var(--bg-2);
  }
  .answer { font-size: 1.08rem; color: #eaf0f8; margin: 0 0 16px; }
  .answer strong { color: var(--cyan); }
  .kf { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-2); margin: 0 0 8px; }
  ul { margin: 0; padding-left: 0; list-style: none; }
  li { position: relative; padding-left: 22px; margin: 6px 0; color: #d3dbe7; font-size: 0.97rem; }
  li::before { content: ''; position: absolute; left: 2px; top: 0.62em; width: 8px; height: 8px; border-radius: 50%; background: var(--grad); box-shadow: 0 0 10px rgba(117, 216, 255, 0.6); }
</style>
