---
interface Props { answer: string; facts: string[]; label?: string; answerLabel?: string }
const { answer, facts, label = 'Key facts', answerLabel = 'In short' } = Astro.props;
---
<aside class="tldr" aria-label={label}>
  <p class="answer"><strong>{answerLabel}:</strong> {answer}</p>
  <h2 class="kf">{label}</h2>
  <ul>{facts.map((f) => <li>{f}</li>)}</ul>
</aside>
<style>
  .tldr {
    max-width: var(--prose); margin: 8px 0 40px; padding: 22px 24px;
    border-radius: var(--radius); border: 1px solid var(--kf-border);
    background: radial-gradient(120% 140% at 0% 0%, var(--kf-glow), transparent 60%), var(--surface);
    box-shadow: var(--shadow-card);
  }
  .answer { font-size: 1.08rem; color: var(--text); margin: 0 0 16px; line-height: 1.6; }
  .answer strong { color: var(--accent-text); }
  .kf { font-size: 0.76rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-2); margin: 0 0 8px; font-weight: 650; }
  ul { margin: 0; padding-left: 0; list-style: none; }
  li { position: relative; padding-left: 22px; margin: 7px 0; color: var(--prose-text); font-size: 0.97rem; line-height: 1.55; }
  li::before { content: ''; position: absolute; left: 2px; top: 0.58em; width: 8px; height: 8px; border-radius: 50%; background: var(--grad); box-shadow: 0 0 10px rgba(117, 216, 255, 0.45); }
</style>
