---
/**
 * Footer background: a seeded (deterministic) starfield with constellations
 * that draw themselves like an unlock pattern. Generated at build time as
 * inline SVG + CSS keyframes — no runtime JS. Only opacity and
 * stroke-dashoffset animate. Reduced motion: one static constellation.
 */
const W = 1440, H = 520;
let seed = 0x5eed1234;
const rnd = () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
const r1 = (n: number) => Math.round(n * 10) / 10;
const ri = (n: number) => Math.round(n);

// Faint 5×5 lattice near the top centre: a nod to the unlock grid.
const LAT = { x0: 676, y0: 18, step: 22 };
const lat = (r: number, c: number): [number, number] => [LAT.x0 + c * LAT.step, LAT.y0 + r * LAT.step];

// Constellations (points in viewBox units). C2 is an unlock pattern on the lattice.
const CONST: [number, number][][] = [
  [[40, 64], [112, 26], [196, 70], [282, 38], [356, 84], [300, 104], [214, 96]],
  [[1050, 58], [1128, 24], [1214, 66], [1292, 30], [1384, 78], [1336, 104]],
  [lat(0, 1), lat(1, 0), lat(2, 1), lat(2, 2), lat(1, 3), lat(3, 4), lat(4, 3), lat(3, 2)],
  [[1372, 168], [1410, 236], [1362, 300], [1404, 382], [1350, 452]],
];

type Star = { x: number; y: number; r: number; o: number; tw?: number };
const stars: Star[] = [];
for (let r = 0; r < 5; r++) for (let c = 0; c < 5; c++) { const [x, y] = lat(r, c); stars.push({ x, y, r: 0.9, o: 0.24 }); }
// Scattered stars biased to the edges and the top band.
while (stars.length < 66) {
  // Top band (above the link columns) or the outer side margins only.
  const band = rnd() < 0.62;
  const x = band ? rnd() * W : rnd() < 0.5 ? rnd() * 120 : W - rnd() * 120;
  const y = band ? 4 + rnd() * 108 : 110 + Math.pow(rnd(), 1.3) * (H - 110);
  if (x > 650 && x < 790 && y < 125) continue; // keep the lattice clean
  stars.push({ x, y, r: 0.6 + rnd() * 0.9, o: 0.15 + rnd() * 0.45, tw: rnd() < 0.16 ? Math.floor(4 + rnd() * 5) : undefined });
}

const SLOT = 6.5; // seconds per constellation
const CYCLE = SLOT * CONST.length; // 26s loop
const DRAW = 3.2; // seconds to draw one constellation
const pct = (s: number) => r1((s / CYCLE) * 100);

let css = `.sf .cl{stroke-dasharray:1;stroke-dashoffset:1;opacity:0;animation:sf-draw ${CYCLE}s linear infinite}`;
css += `@keyframes sf-draw{0%{stroke-dashoffset:1;opacity:1}${pct(DRAW)}%{stroke-dashoffset:0;opacity:1}${pct(SLOT * 0.78)}%{stroke-dashoffset:0;opacity:1}${pct(SLOT * 0.95)}%,100%{stroke-dashoffset:0;opacity:0}}`;
css += `@keyframes sf-ping{0%{opacity:0}1.2%{opacity:1}4%{opacity:.55}${pct(SLOT * 0.7)}%{opacity:.55}${pct(SLOT * 0.9)}%,100%{opacity:0}}`;
css += `@keyframes sf-tw{0%,100%{opacity:var(--o)}50%{opacity:calc(var(--o) * .25)}}`;
css += `.sf .nd{opacity:0;animation:sf-ping ${CYCLE}s ease-out infinite}`;
css += `.sf .tw{animation:sf-tw var(--d) ease-in-out infinite}`;
CONST.forEach((_, i) => { css += `.sf .c${i} .cl{animation-delay:${r1(i * SLOT)}s}`; });
css += `@media (prefers-reduced-motion:reduce){.sf .cl,.sf .nd,.sf .tw{animation:none!important}.sf .c2 .cl{stroke-dashoffset:0;opacity:1}.sf .c2 .nd{opacity:.55}}`;

const groups = CONST.map((pts, i) => {
  const segs = pts.slice(1).map((p, k) => Math.hypot(p[0] - pts[k][0], p[1] - pts[k][1]));
  const total = segs.reduce((a, b) => a + b, 0);
  let acc = 0;
  const nodes = pts.map((p, k) => {
    if (k) acc += segs[k - 1];
    return { x: p[0], y: p[1], delay: r1(i * SLOT + (acc / total) * DRAW) };
  });
  return { i, d: pts.map((p, k) => `${k ? 'L' : 'M'}${p[0]} ${p[1]}`).join(''), nodes };
});

// Compact markup string (self-closing tags, no framework attributes) keeps the layer small.
const f = (n: number) => String(r1(n)).replace(/^0\./, '.');
let gl = '';
for (let k = 0; k < 5; k++) {
  gl += `M${LAT.x0 - 14} ${LAT.y0 + k * LAT.step}h${4 * LAT.step + 28}M${LAT.x0 + k * LAT.step} ${LAT.y0 - 14}v${4 * LAT.step + 28}`;
}
let inner = '<defs><linearGradient id="sf-g" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#4F8CFF"/><stop offset="1" stop-color="#75D8FF"/></linearGradient></defs>';
inner += `<path class="gl" d="${gl}"/><g class="st">`;
for (const st of stars) {
  inner += st.tw
    ? `<circle cx="${ri(st.x)}" cy="${ri(st.y)}" r="${f(st.r)}" class="tw" opacity="${f(st.o)}" style="--o:${f(st.o)};--d:${st.tw}s;animation-delay:${f(st.x / 160)}s"/>`
    : `<circle cx="${ri(st.x)}" cy="${ri(st.y)}" r="${f(st.r)}" opacity="${f(st.o)}"/>`;
}
inner += '</g>';
for (const g of groups) {
  inner += `<g class="c${g.i}"><path class="cl" d="${g.d}" pathLength="1"/>`;
  for (const n of g.nodes) inner += `<g class="nd" style="animation-delay:${n.delay}s"><circle cx="${n.x}" cy="${n.y}" r="2" class="core"/><circle cx="${n.x}" cy="${n.y}" r="5" class="ring"/></g>`;
  inner += '</g>';
}
---
<svg class="sf" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false" set:html={inner}></svg>
<style is:inline set:html={css}></style>
<style is:global>
  .sf {
    position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 520px; pointer-events: none; z-index: 0;
    opacity: .45;
    -webkit-mask-image: linear-gradient(#000 0%, #000 60%, transparent 100%);
    mask-image: linear-gradient(#000 0%, #000 60%, transparent 100%);
  }
  .sf .st circle { fill: var(--star); }
  .sf .gl { fill: none; stroke: var(--star); stroke-width: 1; opacity: .06; }
  .sf .cl { fill: none; stroke: url(#sf-g); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .sf .core { fill: #c9efff; }
  .sf .ring { fill: none; stroke: #75d8ff; stroke-width: 1; opacity: .6; }
  :root[data-theme='light'] .sf { opacity: .2; }
  :root[data-theme='light'] .sf .cl { stroke: #0b1a2e; }
  :root[data-theme='light'] .sf .core { fill: #0b1a2e; }
  :root[data-theme='light'] .sf .ring { stroke: #1a5ad1; }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .sf { opacity: .2; }
    :root:not([data-theme='dark']) .sf .cl { stroke: #0b1a2e; }
    :root:not([data-theme='dark']) .sf .core { fill: #0b1a2e; }
    :root:not([data-theme='dark']) .sf .ring { stroke: #1a5ad1; }
  }
</style>
