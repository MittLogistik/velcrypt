---
/** Velcrypt mark (glossy blue shield + V, from brand/velcrypt-mark.png) with optional "Velcrypt" wordmark. */
interface Props { size?: number; uid?: string; title?: string; wordmark?: boolean }
const { size = 32, title, wordmark = false } = Astro.props;
// Source mark is 446×490.
const width = Math.round(size * 446 / 490);
---
<span class="logo">
  <picture>
    <source type="image/webp" srcset="/brand/velcrypt-mark-80.webp 80w, /brand/velcrypt-mark-120.webp 120w" sizes={`${width}px`} />
    <img src="/brand/velcrypt-mark-120.png" width={width} height={size} alt={title ?? ''} decoding="async" />
  </picture>
  {wordmark && <span class="wm">Vel<span class="wm-c">crypt</span></span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo img { display: block; flex: none; }
  .wm { font-weight: 800; font-size: 1.18rem; letter-spacing: -0.025em; color: #fff; }
  .wm-c {
    background: linear-gradient(100deg, #12D9FB 0%, #1C8CFF 45%, #0A3BE0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
