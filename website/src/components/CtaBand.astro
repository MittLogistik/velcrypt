---
import AppStoreButton from './AppStoreButton.astro';
import PatternGrid from './PatternGrid.astro';
import { TAGLINE } from '../config/site';
import { t } from '../i18n/ui';

interface Props { ct: string; locale?: string; title?: string; text?: string }
const { ct, locale = 'en', title = TAGLINE } = Astro.props;
const text = Astro.props.text ?? t(locale, 'cta_band_text');
---
<section class="cta-band" aria-label={t(locale, 'cta_band_aria')}>
  <div class="inner">
    <div class="copy">
      <p class="h" lang="en">{title}</p>
      <p class="muted">{text}</p>
      <AppStoreButton ct={ct} locale={locale} note size="lg" />
    </div>
    <div class="art" aria-hidden="true"><PatternGrid uid={`cta-${ct}`} size={180} pattern="cta" /></div>
  </div>
</section>
<style>
  .cta-band { margin: 72px 0 0; }
  .inner {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    padding: clamp(28px, 4.5vw, 52px); border-radius: 26px; border: 1px solid var(--kf-border);
    background:
      radial-gradient(90% 120% at 100% 0%, rgba(79, 140, 255, 0.2), transparent 55%),
      radial-gradient(70% 100% at 0% 100%, rgba(117, 216, 255, 0.1), transparent 60%),
      var(--surface);
    box-shadow: var(--shadow-card);
  }
  .h { font-size: clamp(1.6rem, 3.2vw, 2.3rem); font-weight: 750; letter-spacing: -0.03em; line-height: 1.12; margin: 0 0 12px; color: var(--text); }
  .muted { max-width: 54ch; margin-bottom: 24px; font-size: 1.04rem; }
  .art { padding: 14px; border-radius: 28px; background: color-mix(in srgb, var(--bg) 55%, transparent); border: 1px solid var(--line); }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; } .art { display: none; } }
</style>
