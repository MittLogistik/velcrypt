---
import AppStoreButton from './AppStoreButton.astro';
import PatternGrid from './PatternGrid.astro';
import { TAGLINE } from '../config/site';

interface Props { ct: string; locale?: string; title?: string; text?: string }
const { ct, locale = 'en', title = TAGLINE, text = 'Draw a pattern, open a private vault. Your photos, videos and documents stay encrypted on your iPhone, with no account and no cloud.' } = Astro.props;
---
<section class="cta-band" aria-label="Get Velcrypt">
  <div class="inner">
    <div class="copy">
      <p class="h">{title}</p>
      <p class="muted">{text}</p>
      <AppStoreButton ct={ct} locale={locale} note size="lg" />
    </div>
    <div class="art" aria-hidden="true"><PatternGrid uid={`cta-${ct}`} size={190} pattern="cta" /></div>
  </div>
</section>
<style>
  .cta-band { margin: 64px 0 0; }
  .inner {
    display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center;
    padding: clamp(26px, 4vw, 44px); border-radius: 24px; border: 1px solid rgba(117, 216, 255, 0.25);
    background: radial-gradient(100% 120% at 100% 0%, rgba(79, 140, 255, 0.2), transparent 55%), radial-gradient(80% 100% at 0% 100%, rgba(117, 216, 255, 0.1), transparent 60%), var(--bg-2);
  }
  .h { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 750; letter-spacing: -0.03em; line-height: 1.15; margin: 0 0 10px; }
  .muted { max-width: 520px; margin-bottom: 22px; }
  @media (max-width: 720px) { .inner { grid-template-columns: 1fr; } .art { display: none; } }
</style>
