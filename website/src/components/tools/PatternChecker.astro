---
/** 5×5 pattern strength checker. Runs locally; nothing is stored or sent. */
const dots = Array.from({ length: 25 }, (_, i) => i);
---
<section class="tool card" aria-labelledby="pc-h">
  <h2 id="pc-h">Test a pattern</h2>
  <p class="muted">Drag across the dots, or tap them one by one (keyboard: Tab and Enter). Use a pattern that is <em>similar</em> to yours, never your real one.</p>
  <div class="pc">
    <div class="board" id="pc-board">
      <svg viewBox="0 0 500 500" aria-hidden="true" focusable="false">
        <defs><linearGradient id="pc-g" x1="0" y1="0" x2="500" y2="500" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#4F8CFF"/><stop offset="1" stop-color="#75D8FF"/></linearGradient></defs>
        <polyline id="pc-line" fill="none" stroke="url(#pc-g)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" points="" />
        <line id="pc-tail" stroke="#75D8FF" stroke-opacity=".45" stroke-width="6" stroke-linecap="round" x1="0" y1="0" x2="0" y2="0" visibility="hidden" />
      </svg>
      <div class="dots">
        {dots.map((i) => <button type="button" class="dot" data-i={i} aria-label={`Row ${Math.floor(i / 5) + 1}, column ${(i % 5) + 1}`}><span></span></button>)}
      </div>
    </div>
    <div class="result" aria-live="polite">
      <p class="rating" id="pc-rating">Draw a pattern to start</p>
      <div class="meter" aria-hidden="true"><span id="pc-bar"></span></div>
      <p class="bits" id="pc-bits"></p>
      <ul id="pc-notes" class="notes"></ul>
      <button type="button" class="btn btn-ghost" id="pc-reset">Clear</button>
    </div>
  </div>
</section>

<script>
  const board = document.getElementById('pc-board')!;
  const line = document.getElementById('pc-line') as unknown as SVGPolylineElement;
  const tail = document.getElementById('pc-tail') as unknown as SVGLineElement;
  const buttons = [...board.querySelectorAll<HTMLButtonElement>('.dot')];
  const C = (i: number) => [50 + (i % 5) * 100, 50 + Math.floor(i / 5) * 100];
  let seq: number[] = [];
  let drawing = false;

  function cross(a: number[], b: number[], c: number[], d: number[]) {
    const o = (p: number[], q: number[], r: number[]) => Math.sign((q[0] - p[0]) * (r[1] - p[1]) - (q[1] - p[1]) * (r[0] - p[0]));
    return o(a, b, c) * o(a, b, d) < 0 && o(c, d, a) * o(c, d, b) < 0;
  }

  function analyse(s: number[]) {
    const n = s.length;
    const pts = s.map((i) => [i % 5, Math.floor(i / 5)]);
    const dirs: string[] = [];
    let ortho = true, jumps = 0;
    for (let k = 1; k < n; k++) {
      const dx = pts[k][0] - pts[k - 1][0], dy = pts[k][1] - pts[k - 1][1];
      const g = Math.max(Math.abs(dx), Math.abs(dy));
      if (dx !== 0 && dy !== 0) ortho = false;
      if (g > 1) jumps++;
      const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : Math.abs(a));
      const q = gcd(Math.abs(dx), Math.abs(dy)) || 1;
      dirs.push(`${dx / q},${dy / q}`);
    }
    let turns = 0, run = 1, maxRun = 1;
    for (let k = 1; k < dirs.length; k++) {
      if (dirs[k] !== dirs[k - 1]) { turns++; run = 1; } else { run++; maxRun = Math.max(maxRun, run); }
    }
    let crossings = 0;
    for (let a = 0; a < n - 1; a++) for (let b = a + 2; b < n - 1; b++) if (cross(pts[a], pts[a + 1], pts[b], pts[b + 1])) crossings++;
    const rows = new Set(pts.map((p) => p[1])).size, cols = new Set(pts.map((p) => p[0])).size;
    const corner = [0, 4, 20, 24].includes(s[0]);
    const notes: string[] = [];
    let bits = n ? Math.log2(25) : 0;
    for (let k = 1; k < n; k++) bits += Math.log2(Math.min(8, 25 - k));
    if (turns < 2) { bits -= 4; notes.push('Few changes of direction make the shape easy to guess.'); }
    else if (turns > 2) bits += Math.min(3, turns - 2);
    if (corner) { bits -= 2; notes.push('Starting in a corner is the most common choice.'); }
    if (crossings) { bits += Math.min(3, crossings * 1.5); notes.push('Crossing your own path adds useful unpredictability.'); }
    if (rows <= 2 && cols <= 2) { bits -= 3; notes.push('The pattern uses only a small part of the grid.'); }
    else if (rows >= 4 && cols >= 4) bits += 1;
    if (maxRun >= 4) { bits -= 2; notes.push('A long straight run is easy to spot from a distance.'); }
    if (ortho && jumps === 0 && turns <= 3 && n > 2) { bits -= 3; notes.push('Only straight, neighbouring moves with few turns resemble a letter or simple shape (L, U, Z, square).'); }
    if (!ortho) notes.push('Diagonal moves widen the range of possible patterns.');
    if (n >= 8) notes.push('Eight or more dots is in the recommended range.');
    bits = Math.max(0, bits);
    let rating = 'Very strong', level = 5;
    if (n < 6) { rating = 'Too short'; level = 0; notes.unshift('Velcrypt needs at least 6 dots.'); }
    else if (turns < 1) { rating = 'Needs a turn'; level = 0; notes.unshift('Velcrypt needs at least one change of direction.'); }
    else if (bits < 16) { rating = 'Weak'; level = 1; }
    else if (bits < 24) { rating = 'Fair'; level = 2; }
    else if (bits < 32) { rating = 'Strong'; level = 3; }
    return { n, bits, rating, level, notes };
  }

  function render(pointer?: number[]) {
    line.setAttribute('points', seq.map((i) => C(i).join(',')).join(' '));
    buttons.forEach((b, i) => { const k = seq.indexOf(i); b.classList.toggle('on', k >= 0); b.setAttribute('aria-pressed', String(k >= 0)); });
    if (pointer && seq.length) {
      const [x, y] = C(seq[seq.length - 1]);
      tail.setAttribute('x1', String(x)); tail.setAttribute('y1', String(y)); tail.setAttribute('x2', String(pointer[0])); tail.setAttribute('y2', String(pointer[1]));
      tail.setAttribute('visibility', 'visible');
    } else tail.setAttribute('visibility', 'hidden');
    const r = analyse(seq);
    const rating = document.getElementById('pc-rating')!;
    rating.textContent = seq.length ? `${r.rating} · ${r.n} dot${r.n === 1 ? '' : 's'}` : 'Draw a pattern to start';
    rating.dataset.level = seq.length ? String(r.level) : '';
    (document.getElementById('pc-bar') as HTMLElement).style.width = seq.length ? `${Math.max(6, (r.level / 5) * 100)}%` : '0';
    (document.getElementById('pc-bar') as HTMLElement).dataset.level = String(r.level);
    document.getElementById('pc-bits')!.textContent = seq.length >= 2 ? `Rough estimate: about ${Math.round(r.bits)} bits. A heuristic, not a guarantee.` : '';
    const ul = document.getElementById('pc-notes')!;
    ul.replaceChildren(...(seq.length ? r.notes : []).map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
  }

  function add(i: number) { if (!seq.includes(i)) { seq.push(i); render(); } }
  function toLocal(e: PointerEvent) { const r = board.getBoundingClientRect(); return [((e.clientX - r.left) / r.width) * 500, ((e.clientY - r.top) / r.height) * 500]; }
  function hit(p: number[]) { for (let i = 0; i < 25; i++) { const [x, y] = C(i); if (Math.hypot(p[0] - x, p[1] - y) < 34) return i; } return -1; }

  board.addEventListener('pointerdown', (e) => {
    const i = hit(toLocal(e));
    if (i < 0) return;
    e.preventDefault();
    drawing = true; seq = []; add(i);
    board.setPointerCapture(e.pointerId);
  });
  board.addEventListener('pointermove', (e) => {
    if (!drawing) return;
    const p = toLocal(e); const i = hit(p);
    if (i >= 0) add(i);
    render(p);
  });
  const end = () => { if (drawing) { drawing = false; render(); } };
  board.addEventListener('pointerup', end);
  board.addEventListener('pointercancel', end);
  buttons.forEach((b) => b.addEventListener('click', (e) => { if ((e as MouseEvent).detail === 0) add(Number(b.dataset.i)); }));
  document.getElementById('pc-reset')!.addEventListener('click', () => { seq = []; render(); });
  render();
</script>

<style>
  .tool { margin: 0 0 44px; max-width: var(--prose); }
  .tool h2 { font-size: 1.35rem; margin-bottom: 6px; }
  .pc { display: grid; grid-template-columns: minmax(0, 320px) 1fr; gap: 28px; align-items: start; margin-top: 18px; }
  .board { position: relative; width: 100%; aspect-ratio: 1; touch-action: none; user-select: none; -webkit-user-select: none; border-radius: 20px; background: radial-gradient(circle at 50% 40%, #16233a, #0d1526); border: 1px solid var(--line); }
  .board svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .dots { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); grid-template-rows: repeat(5, 1fr); }
  .dot { all: unset; display: grid; place-items: center; cursor: pointer; border-radius: 50%; }
  .dot span { width: 15px; height: 15px; border-radius: 50%; background: #2f4060; transition: transform .15s, background .15s, box-shadow .15s; }
  .dot.on span { background: #75d8ff; transform: scale(1.35); box-shadow: 0 0 14px rgba(117,216,255,.8); }
  .dot:focus-visible span { outline: 2px solid #fff; outline-offset: 4px; }
  .rating { font-size: 1.3rem; font-weight: 700; margin: 0 0 10px; }
  .rating[data-level='0'] { color: #ff9a8a; }
  .rating[data-level='1'] { color: var(--warn); }
  .rating[data-level='3'], .rating[data-level='4'], .rating[data-level='5'] { color: var(--cyan); }
  .meter { height: 8px; border-radius: 9px; background: var(--bg-3); overflow: hidden; margin-bottom: 10px; }
  .meter span { display: block; height: 100%; width: 0; background: var(--grad); transition: width .25s; }
  .meter span[data-level='0'] { background: #ff9a8a; }
  .meter span[data-level='1'] { background: var(--warn); }
  .bits { color: var(--text-2); font-size: .9rem; min-height: 1.4em; }
  .notes { padding-left: 1.1em; margin: 0 0 16px; font-size: .93rem; color: #cdd6e3; }
  .notes li { margin: 4px 0; }
  @media (max-width: 640px) { .pc { grid-template-columns: 1fr; } .board { max-width: 320px; } }
</style>
