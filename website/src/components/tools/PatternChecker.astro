---
/** 5×5 pattern strength checker. Runs locally; nothing is stored or sent. */
import { getCopy, fmt } from '../../i18n/copy/index';
interface Props { locale?: string }
const { locale = 'en' } = Astro.props;
const T = getCopy(locale).tools.pattern;
const dots = Array.from({ length: 25 }, (_, i) => i);
---
<section class="tool card" aria-labelledby="pc-h" id="pc-tool" data-i18n={JSON.stringify(T)}>
  <h2 id="pc-h">{T.title}</h2>
  <p class="muted">{T.intro}</p>
  <div class="pc">
    <div class="board" id="pc-board">
      <svg viewBox="0 0 500 500" aria-hidden="true" focusable="false">
        <defs><linearGradient id="pc-g" x1="0" y1="0" x2="500" y2="500" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#4F8CFF"/><stop offset="1" stop-color="#75D8FF"/></linearGradient></defs>
        <polyline id="pc-line" fill="none" stroke="url(#pc-g)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" points="" />
        <line id="pc-tail" stroke="#75D8FF" stroke-opacity=".45" stroke-width="6" stroke-linecap="round" x1="0" y1="0" x2="0" y2="0" visibility="hidden" />
      </svg>
      <div class="dots">
        {dots.map((i) => <button type="button" class="dot" data-i={i} aria-label={fmt(T.dotLabel, { r: Math.floor(i / 5) + 1, c: (i % 5) + 1 })}><span></span></button>)}
      </div>
    </div>
    <div class="result" aria-live="polite">
      <p class="rating" id="pc-rating">{T.start}</p>
      <div class="meter" aria-hidden="true"><span id="pc-bar"></span></div>
      <p class="bits" id="pc-bits"></p>
      <ul id="pc-notes" class="notes"></ul>
      <button type="button" class="btn btn-ghost" id="pc-reset">{T.clear}</button>
    </div>
  </div>
</section>

<script>
  const T = JSON.parse((document.getElementById('pc-tool') as HTMLElement).dataset.i18n || '{}');
  const F = (s: string, n: number) => s.replace('{n}', String(n));
  const board = document.getElementById('pc-board')!;
  const line = document.getElementById('pc-line') as unknown as SVGPolylineElement;
  const tail = document.getElementById('pc-tail') as unknown as SVGLineElement;
  const buttons = [...board.querySelectorAll<HTMLButtonElement>('.dot')];
  const C = (i: number) => [50 + (i % 5) * 100, 50 + Math.floor(i / 5) * 100];
  let seq: number[] = [];
  let drawing = false;

  function cross(a: number[], b: number[], c: number[], d: number[]) {
    const o = (p: number[], q: number[], r: number[]) => Math.sign((q[0] - p[0]) * (r[1] - p[1]) - (q[1] - p[1]) * (r[0] - p[0]));
    return o(a, b, c) * o(a, b, d) < 0 && o(c, d, a) * o(c, d, b) < 0;
  }

  function analyse(s: number[]) {
    const n = s.length;
    const pts = s.map((i) => [i % 5, Math.floor(i / 5)]);
    const dirs: string[] = [];
    let ortho = true, jumps = 0;
    for (let k = 1; k < n; k++) {
      const dx = pts[k][0] - pts[k - 1][0], dy = pts[k][1] - pts[k - 1][1];
      const g = Math.max(Math.abs(dx), Math.abs(dy));
      if (dx !== 0 && dy !== 0) ortho = false;
      if (g > 1) jumps++;
      const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : Math.abs(a));
      const q = gcd(Math.abs(dx), Math.abs(dy)) || 1;
      dirs.push(`${dx / q},${dy / q}`);
    }
    let turns = 0, run = 1, maxRun = 1;
    for (let k = 1; k < dirs.length; k++) {
      if (dirs[k] !== dirs[k - 1]) { turns++; run = 1; } else { run++; maxRun = Math.max(maxRun, run); }
    }
    let crossings = 0;
    for (let a = 0; a < n - 1; a++) for (let b = a + 2; b < n - 1; b++) if (cross(pts[a], pts[a + 1], pts[b], pts[b + 1])) crossings++;
    const rows = new Set(pts.map((p) => p[1])).size, cols = new Set(pts.map((p) => p[0])).size;
    const corner = [0, 4, 20, 24].includes(s[0]);
    const notes: string[] = [];
    let bits = n ? Math.log2(25) : 0;
    for (let k = 1; k < n; k++) bits += Math.log2(Math.min(8, 25 - k));
    if (turns < 2) { bits -= 4; notes.push(T.notes.fewTurns); }
    else if (turns > 2) bits += Math.min(3, turns - 2);
    if (corner) { bits -= 2; notes.push(T.notes.corner); }
    if (crossings) { bits += Math.min(3, crossings * 1.5); notes.push(T.notes.crossing); }
    if (rows <= 2 && cols <= 2) { bits -= 3; notes.push(T.notes.small); }
    else if (rows >= 4 && cols >= 4) bits += 1;
    if (maxRun >= 4) { bits -= 2; notes.push(T.notes.straight); }
    if (ortho && jumps === 0 && turns <= 3 && n > 2) { bits -= 3; notes.push(T.notes.shape); }
    if (!ortho) notes.push(T.notes.diagonal);
    if (n >= 8) notes.push(T.notes.long);
    bits = Math.max(0, bits);
    let rating = T.ratings.veryStrong, level = 5;
    if (n < 6) { rating = T.ratings.tooShort; level = 0; notes.unshift(T.notes.min6); }
    else if (turns < 1) { rating = T.ratings.needsTurn; level = 0; notes.unshift(T.notes.minTurn); }
    else if (bits < 16) { rating = T.ratings.weak; level = 1; }
    else if (bits < 24) { rating = T.ratings.fair; level = 2; }
    else if (bits < 32) { rating = T.ratings.strong; level = 3; }
    return { n, bits, rating, level, notes };
  }

  function render(pointer?: number[]) {
    line.setAttribute('points', seq.map((i) => C(i).join(',')).join(' '));
    buttons.forEach((b, i) => { const k = seq.indexOf(i); b.classList.toggle('on', k >= 0); b.setAttribute('aria-pressed', String(k >= 0)); });
    if (pointer && seq.length) {
      const [x, y] = C(seq[seq.length - 1]);
      tail.setAttribute('x1', String(x)); tail.setAttribute('y1', String(y)); tail.setAttribute('x2', String(pointer[0])); tail.setAttribute('y2', String(pointer[1]));
      tail.setAttribute('visibility', 'visible');
    } else tail.setAttribute('visibility', 'hidden');
    const r = analyse(seq);
    const rating = document.getElementById('pc-rating')!;
    rating.textContent = seq.length ? `${r.rating} · ${F(r.n === 1 ? T.dot : T.dots, r.n)}` : T.start;
    rating.dataset.level = seq.length ? String(r.level) : '';
    (document.getElementById('pc-bar') as HTMLElement).style.width = seq.length ? `${Math.max(6, (r.level / 5) * 100)}%` : '0';
    (document.getElementById('pc-bar') as HTMLElement).dataset.level = String(r.level);
    document.getElementById('pc-bits')!.textContent = seq.length >= 2 ? F(T.bits, Math.round(r.bits)) : '';
    const ul = document.getElementById('pc-notes')!;
    ul.replaceChildren(...(seq.length ? r.notes : []).map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
  }

  // Dots strictly between two grid points (e.g. 0→4 passes 1, 2, 3), as in the app.
  function between(a: number, b: number) {
    const dr = Math.floor(b / 5) - Math.floor(a / 5), dc = (b % 5) - (a % 5);
    const gcd = (x: number, y: number): number => (y ? gcd(y, x % y) : x);
    const steps = gcd(Math.abs(dr), Math.abs(dc));
    const out: number[] = [];
    for (let k = 1; k < steps; k++) out.push((Math.floor(a / 5) + (dr / steps) * k) * 5 + (a % 5) + (dc / steps) * k);
    return out;
  }
  function add(i: number) {
    if (seq.includes(i)) return false;
    const last = seq[seq.length - 1];
    if (last !== undefined) for (const m of between(last, i)) if (!seq.includes(m)) seq.push(m);
    seq.push(i);
    return true;
  }
  function toLocal(e: PointerEvent) { const r = board.getBoundingClientRect(); return [((e.clientX - r.left) / r.width) * 500, ((e.clientY - r.top) / r.height) * 500]; }
  function hit(p: number[], radius = 38) { for (let i = 0; i < 25; i++) { const [x, y] = C(i); if (Math.hypot(p[0] - x, p[1] - y) < radius) return i; } return -1; }
  function nearest(p: number[]) {
    let best = -1, dist = Infinity;
    for (let i = 0; i < 25; i++) { const [x, y] = C(i); const d = Math.hypot(p[0] - x, p[1] - y); if (d < dist) { dist = d; best = i; } }
    return dist < 70 ? best : -1;
  }

  // Rendering is batched to one frame; the analysis only reruns when the sequence changes.
  let lastPoint: number[] | null = null;
  let pointer: number[] | undefined;
  let dirty = false, frame = 0;
  function schedule(changed: boolean) {
    dirty ||= changed;
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      if (dirty) { dirty = false; render(pointer); } else drawTail();
    });
  }
  function drawTail() {
    if (pointer && seq.length) {
      const [x, y] = C(seq[seq.length - 1]);
      tail.setAttribute('x1', String(x)); tail.setAttribute('y1', String(y)); tail.setAttribute('x2', String(pointer[0])); tail.setAttribute('y2', String(pointer[1]));
      tail.setAttribute('visibility', 'visible');
    } else tail.setAttribute('visibility', 'hidden');
  }

  // Samples along the segment since the last event, so fast swipes can't jump over a dot.
  function trace(from: number[], to: number[]) {
    let changed = false;
    const steps = Math.max(1, Math.ceil(Math.hypot(to[0] - from[0], to[1] - from[1]) / 12));
    for (let s = 1; s <= steps; s++) {
      const i = hit([from[0] + ((to[0] - from[0]) * s) / steps, from[1] + ((to[1] - from[1]) * s) / steps]);
      if (i >= 0 && add(i)) changed = true;
    }
    return changed;
  }

  board.addEventListener('pointerdown', (e) => {
    // Start from the nearest dot, so a slightly-off first touch still begins a pattern.
    const p = toLocal(e);
    const i = nearest(p);
    if (i < 0) return;
    e.preventDefault();
    drawing = true; seq = []; add(i);
    lastPoint = p; pointer = p;
    board.setPointerCapture(e.pointerId);
    schedule(true);
  });
  board.addEventListener('pointermove', (e) => {
    if (!drawing || !lastPoint) return;
    e.preventDefault();
    let changed = false;
    const samples = typeof e.getCoalescedEvents === 'function' ? e.getCoalescedEvents() : [];
    for (const ev of samples.length ? samples : [e]) {
      const p = toLocal(ev);
      if (trace(lastPoint, p)) changed = true;
      lastPoint = p;
    }
    pointer = lastPoint;
    schedule(changed);
  });
  const end = () => {
    if (!drawing) return;
    drawing = false; lastPoint = null; pointer = undefined;
    if (frame) { cancelAnimationFrame(frame); frame = 0; }
    dirty = false;
    render();
  };
  board.addEventListener('pointerup', end);
  board.addEventListener('pointercancel', end);
  board.addEventListener('lostpointercapture', end);
  // Stop iOS from turning a drag into a scroll or text selection.
  board.addEventListener('touchmove', (e) => { if (drawing) e.preventDefault(); }, { passive: false });
  buttons.forEach((b) => b.addEventListener('click', (e) => { if ((e as MouseEvent).detail === 0 && add(Number(b.dataset.i))) render(); }));
  document.getElementById('pc-reset')!.addEventListener('click', () => { seq = []; render(); });
  render();
</script>

<style>
  .tool { margin: 0 0 44px; max-width: var(--prose); }
  .tool h2 { font-size: 1.35rem; margin-bottom: 6px; }
  .pc { display: grid; grid-template-columns: minmax(0, 320px) 1fr; gap: 28px; align-items: start; margin-top: 18px; }
  .board { position: relative; width: 100%; aspect-ratio: 1; touch-action: none; user-select: none; -webkit-user-select: none; border-radius: 20px; background: radial-gradient(circle at 50% 40%, var(--board-a, #16233a), var(--board-b, #0d1526)); border: 1px solid var(--line); }
  :global(:root[data-theme='light']) .board { --board-a: #ffffff; --board-b: #e9eff8; }
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme='dark'])) .board { --board-a: #ffffff; --board-b: #e9eff8; } }
  .board svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .dots { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); grid-template-rows: repeat(5, 1fr); }
  .dot { all: unset; display: grid; place-items: center; cursor: pointer; border-radius: 50%; }
  .dot span { width: 15px; height: 15px; border-radius: 50%; background: var(--pg-dot); transition: transform .15s, background .15s, box-shadow .15s; }
  .dot.on span { background: var(--pg-lit); transform: scale(1.35); box-shadow: 0 0 14px rgba(117,216,255,.8); }
  .dot:focus-visible span { outline: 2px solid var(--text); outline-offset: 4px; }
  .rating { font-size: 1.3rem; font-weight: 700; margin: 0 0 10px; }
  .rating[data-level='0'] { color: var(--danger); }
  .rating[data-level='1'] { color: var(--warn); }
  .rating[data-level='3'], .rating[data-level='4'], .rating[data-level='5'] { color: var(--accent-text); }
  .meter { height: 8px; border-radius: 9px; background: var(--bg-3); overflow: hidden; margin-bottom: 10px; }
  .meter span { display: block; height: 100%; width: 0; background: var(--grad); transition: width .25s; }
  .meter span[data-level='0'] { background: var(--danger); }
  .meter span[data-level='1'] { background: var(--warn); }
  .bits { color: var(--text-2); font-size: .9rem; min-height: 1.4em; }
  .notes { padding-left: 1.1em; margin: 0 0 16px; font-size: .93rem; color: var(--prose-text); }
  .notes li { margin: 4px 0; }
  @media (max-width: 640px) { .pc { grid-template-columns: 1fr; } .board { max-width: 320px; } }
</style>
