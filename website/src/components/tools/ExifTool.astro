---
/** Browser-only EXIF viewer + remover. No uploads: everything runs locally. */
---
<section class="tool card" aria-labelledby="exif-h">
  <h2 id="exif-h">View and remove photo metadata</h2>
  <p class="muted">Your photo never leaves this device. The file is read and cleaned by your browser; nothing is uploaded.</p>
  <label class="drop" id="exif-drop">
    <input id="exif-file" type="file" accept="image/*" />
    <span class="drop-t"><strong>Choose a photo</strong> or drop it here</span>
    <span class="drop-s">JPEG shows full EXIF details. PNG, WebP and (in Safari) HEIC can be cleaned too.</span>
  </label>
  <div id="exif-out" hidden>
    <div class="row">
      <img id="exif-prev" alt="Preview of the selected photo" width="160" height="160" />
      <div class="meta">
        <p id="exif-name" class="fname"></p>
        <p id="exif-gps" class="gps" role="status"></p>
      </div>
    </div>
    <table class="table" aria-describedby="exif-h">
      <caption class="visually-hidden">Metadata found in the selected photo</caption>
      <thead><tr><th scope="col">Field</th><th scope="col">Value</th></tr></thead>
      <tbody id="exif-rows"></tbody>
    </table>
    <div class="actions">
      <button id="exif-clean" class="btn btn-primary" type="button">Remove metadata</button>
      <a id="exif-dl" class="btn btn-ghost" hidden download>Download clean copy</a>
    </div>
    <p id="exif-result" class="muted small" role="status" aria-live="polite"></p>
  </div>
</section>

<script>
  const TAGS: Record<number, string> = {
    0x010f: 'Camera make', 0x0110: 'Camera model', 0x0112: 'Orientation', 0x0131: 'Software', 0x0132: 'Modified',
    0x013b: 'Artist', 0x8298: 'Copyright', 0x9003: 'Date taken', 0x9004: 'Date digitized', 0x9010: 'Time zone',
    0xa434: 'Lens', 0xa433: 'Lens make', 0x829a: 'Exposure time', 0x829d: 'F-number', 0x8827: 'ISO',
    0x920a: 'Focal length', 0xa002: 'Width (px)', 0xa003: 'Height (px)', 0xa420: 'Unique image ID', 0xa431: 'Camera serial number',
  };
  type Val = string | number | number[];

  function readExif(buf: ArrayBuffer): { fields: [string, string][]; gps: { lat: number; lon: number; alt?: number } | null } {
    const v = new DataView(buf);
    const out: [string, string][] = [];
    let gps: { lat: number; lon: number; alt?: number } | null = null;
    if (v.byteLength < 4 || v.getUint16(0) !== 0xffd8) return { fields: out, gps };
    let off = 2;
    while (off + 4 < v.byteLength) {
      if (v.getUint8(off) !== 0xff) break;
      const marker = v.getUint8(off + 1);
      const len = v.getUint16(off + 2);
      if (marker === 0xe1 && v.getUint32(off + 4) === 0x45786966) {
        const tiff = off + 10;
        const le = v.getUint16(tiff) === 0x4949;
        const u16 = (o: number) => v.getUint16(tiff + o, le);
        const u32 = (o: number) => v.getUint32(tiff + o, le);
        const SIZES: Record<number, number> = { 1: 1, 2: 1, 3: 2, 4: 4, 5: 8, 7: 1, 9: 4, 10: 8 };
        const value = (entry: number): Val | null => {
          const type = u16(entry + 2), count = u32(entry + 4), size = SIZES[type];
          if (!size) return null;
          const total = size * count;
          const at = total <= 4 ? entry + 8 : u32(entry + 8);
          if (tiff + at + total > v.byteLength) return null;
          if (type === 2) { let s = ''; for (let i = 0; i < count - 1; i++) s += String.fromCharCode(v.getUint8(tiff + at + i)); return s.trim(); }
          const vals: number[] = [];
          for (let i = 0; i < Math.min(count, 8); i++) {
            const o = at + i * size;
            if (type === 3) vals.push(u16(o));
            else if (type === 4) vals.push(u32(o));
            else if (type === 9) vals.push(v.getInt32(tiff + o, le));
            else if (type === 5 || type === 10) { const d = u32(o + 4); vals.push(d ? (type === 10 ? v.getInt32(tiff + o, le) : u32(o)) / d : 0); }
            else vals.push(v.getUint8(tiff + o));
          }
          return vals.length === 1 ? vals[0] : vals;
        };
        const ifd = (start: number, cb: (tag: number, entry: number) => void) => {
          if (start <= 0 || tiff + start + 2 > v.byteLength) return;
          const n = u16(start);
          for (let i = 0; i < n; i++) { const e = start + 2 + i * 12; if (tiff + e + 12 > v.byteLength) break; cb(u16(e), e); }
        };
        let exifPtr = 0, gpsPtr = 0;
        const g: Record<number, Val | null> = {};
        const collect = (tag: number, e: number) => {
          if (tag === 0x8769) { exifPtr = value(e) as number; return; }
          if (tag === 0x8825) { gpsPtr = value(e) as number; return; }
          if (TAGS[tag]) {
            let val = value(e);
            if (val === null || val === '') return;
            if (tag === 0x829a && typeof val === 'number' && val > 0 && val < 1) val = `1/${Math.round(1 / val)} s`;
            if (tag === 0x829d && typeof val === 'number') val = `f/${val.toFixed(1)}`;
            if (tag === 0x920a && typeof val === 'number') val = `${val.toFixed(1)} mm`;
            out.push([TAGS[tag], Array.isArray(val) ? val.join(', ') : String(val)]);
          }
        };
        ifd(u32(4), collect);
        ifd(exifPtr, collect);
        ifd(gpsPtr, (tag, e) => { g[tag] = value(e); });
        const dms = (x: Val | null | undefined) => (Array.isArray(x) && x.length >= 3 ? x[0] + x[1] / 60 + x[2] / 3600 : null);
        const lat = dms(g[2]), lon = dms(g[4]);
        if (lat !== null && lon !== null) {
          gps = { lat: g[1] === 'S' ? -lat : lat, lon: g[3] === 'W' ? -lon : lon };
          if (typeof g[6] === 'number') gps.alt = g[6];
        }
        break;
      }
      if (marker === 0xda) break;
      off += 2 + len;
    }
    return { fields: out, gps };
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = $<HTMLInputElement>('exif-file');
  const drop = $<HTMLLabelElement>('exif-drop');
  let current: File | null = null;
  let lastUrl = '';

  function kb(n: number) { return n > 1048576 ? (n / 1048576).toFixed(2) + ' MB' : Math.round(n / 1024) + ' KB'; }

  async function handle(file: File) {
    current = file;
    $('exif-out').hidden = false;
    $('exif-name').textContent = `${file.name} · ${kb(file.size)}`;
    const prev = $<HTMLImageElement>('exif-prev');
    if (prev.src) URL.revokeObjectURL(prev.src);
    prev.src = URL.createObjectURL(file);
    $<HTMLAnchorElement>('exif-dl').hidden = true;
    $('exif-result').textContent = '';
    const { fields, gps } = readExif(await file.arrayBuffer());
    const rows = $('exif-rows');
    rows.replaceChildren();
    const add = (k: string, val: string) => { const tr = document.createElement('tr'); const th = document.createElement('th'); th.scope = 'row'; th.textContent = k; const td = document.createElement('td'); td.textContent = val; tr.append(th, td); rows.append(tr); };
    if (gps) add('GPS location', `${gps.lat.toFixed(6)}, ${gps.lon.toFixed(6)}${gps.alt !== undefined ? ` · ${Math.round(gps.alt)} m altitude` : ''}`);
    fields.forEach(([k, val]) => add(k, val));
    if (!rows.children.length) add('Result', /jpe?g$/i.test(file.type) || file.type === 'image/jpeg' ? 'No EXIF metadata found in this JPEG.' : 'Detailed reading supports JPEG only. Cleaning still removes embedded metadata.');
    $('exif-gps').textContent = gps ? 'This photo contains GPS coordinates that reveal where it was taken.' : 'No GPS coordinates found.';
    $('exif-gps').classList.toggle('warn', !!gps);
  }

  input.addEventListener('change', () => { if (input.files?.[0]) handle(input.files[0]); });
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove('over')));
  drop.addEventListener('drop', (e) => { e.preventDefault(); const f = (e as DragEvent).dataTransfer?.files?.[0]; if (f) handle(f); });

  $('exif-clean').addEventListener('click', async () => {
    if (!current) return;
    const res = $('exif-result');
    try {
      const bmp = await createImageBitmap(current, { imageOrientation: 'from-image' });
      const canvas = document.createElement('canvas');
      canvas.width = bmp.width; canvas.height = bmp.height;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('no canvas');
      ctx.drawImage(bmp, 0, 0);
      const blob: Blob | null = await new Promise((r) => canvas.toBlob(r, 'image/jpeg', 0.92));
      if (!blob) throw new Error('encode failed');
      if (lastUrl) URL.revokeObjectURL(lastUrl);
      lastUrl = URL.createObjectURL(blob);
      const a = $<HTMLAnchorElement>('exif-dl');
      a.href = lastUrl;
      a.download = current.name.replace(/\.[^.]+$/, '') + '-clean.jpg';
      a.hidden = false;
      res.textContent = `Done. Clean copy: ${bmp.width}×${bmp.height} px, ${kb(blob.size)}, with no EXIF, GPS, XMP or IPTC data.`;
    } catch {
      res.textContent = 'This browser could not open that image format. Try a JPEG or PNG, or use Safari for HEIC.';
    }
  });
</script>

<style>
  .tool { margin: 0 0 44px; max-width: var(--prose); }
  .tool h2 { font-size: 1.35rem; margin-bottom: 6px; }
  .drop { display: grid; gap: 4px; place-items: center; text-align: center; padding: 30px 18px; margin: 18px 0 8px; border: 1.5px dashed var(--line-strong); border-radius: 16px; cursor: pointer; transition: border-color .2s, background .2s; }
  .drop:hover, .drop.over, .drop:focus-within { border-color: var(--cyan); background: rgba(117,216,255,.05); }
  .drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .drop-t { font-size: 1.05rem; }
  .drop-s { font-size: .85rem; color: var(--text-2); }
  .row { display: flex; gap: 16px; align-items: center; margin: 18px 0 6px; }
  .row img { width: 96px; height: 96px; object-fit: cover; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); }
  .fname { margin: 0 0 4px; font-weight: 600; word-break: break-all; }
  .gps { margin: 0; color: var(--text-2); font-size: .92rem; }
  .gps.warn { color: var(--warn); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-primary { background: var(--grad); color: #0b1220; border: 0; font-family: inherit; }
  .btn-primary:hover { filter: brightness(1.08); }
  .small { font-size: .9rem; margin-top: 12px; }
  .table th[scope='row'] { color: var(--text-2); font-weight: 500; white-space: nowrap; background: none; }
</style>
