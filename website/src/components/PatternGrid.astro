---
/**
 * Animated 5×5 unlock-pattern illustration (pure SVG + CSS, no JS).
 * A blue→cyan line draws the pattern and each dot lights up as the line
 * reaches it. With prefers-reduced-motion the finished pattern is shown
 * statically.
 */
interface Props { uid: string; size?: number; pattern?: 'hero' | 'cta' | 'decoy'; animate?: boolean; label?: string }
const { uid, size = 340, pattern = 'hero', animate = true, label } = Astro.props;

// [row, col] sequences. The hero pattern traces a V and then closes into a
// shield-like loop that crosses its own path (9 dots, several turns).
const PATTERNS: Record<string, [number, number][]> = {
  hero: [[0, 0], [2, 1], [4, 2], [2, 3], [0, 4], [1, 4], [3, 3], [3, 1], [1, 0]],
  cta: [[4, 0], [3, 1], [1, 1], [0, 2], [1, 3], [3, 3], [4, 4], [2, 4]],
  decoy: [[0, 1], [1, 2], [2, 2], [2, 3], [3, 4], [4, 3], [4, 1]],
};
const seq = PATTERNS[pattern];
const GAP = 70, PAD = 35, VB = PAD * 2 + GAP * 4;
const pt = ([r, c]: [number, number]) => [PAD + c * GAP, PAD + r * GAP];
const pts = seq.map(pt);
const d = pts.map((p, i) => `${i ? 'L' : 'M'}${p[0]} ${p[1]}`).join(' ');
const segs = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
const total = segs.reduce((a, b) => a + b, 0);
const cum = [0];
segs.forEach((s) => cum.push(cum[cum.length - 1] + s));

// Timeline (percent of a 7.5s loop): draw 6%→58%, hold, fade 86%→95%.
const DRAW_START = 1, DRAW_END = 55;
const at = (frac: number) => +(DRAW_START + frac * (DRAW_END - DRAW_START)).toFixed(2);
const visited = new Map<string, number>();
seq.forEach(([r, c], i) => { const k = `${r}-${c}`; if (!visited.has(k)) visited.set(k, cum[i] / total); });

const p = `pg-${uid}`;
let css = `.${p} .dot,.${p} .halo{transform-box:fill-box;transform-origin:center}@keyframes ${p}-draw{0%,${DRAW_START}%{stroke-dashoffset:1}${DRAW_END}%,86%{stroke-dashoffset:0;opacity:1}95%,100%{stroke-dashoffset:0;opacity:0}}`;
for (const [k, frac] of visited) {
  const t0 = at(frac), t1 = Math.min(t0 + 1.5, 86);
  css += `@keyframes ${p}-d${k}{0%,${t0}%{fill:#2a3a57;transform:scale(1)}${t1}%{fill:#ffffff;transform:scale(1.55)}${Math.min(t1 + 3, 86)}%,86%{fill:#75D8FF;transform:scale(1.3)}95%,100%{fill:#2a3a57;transform:scale(1)}}`;
  css += `@keyframes ${p}-h${k}{0%,${t0}%{opacity:0;transform:scale(1)}${t1}%{opacity:.9;transform:scale(1.3)}${Math.min(t1 + 8, 86)}%{opacity:0;transform:scale(2.9)}100%{opacity:0}}`;
}
if (animate) {
  css += `.${p} .line{stroke-dasharray:1;stroke-dashoffset:1;animation:${p}-draw 7.5s cubic-bezier(.45,.05,.35,1) infinite}`;
  for (const k of visited.keys()) {
    css += `.${p} .dot-${k}{animation:${p}-d${k} 7.5s linear infinite}.${p} .halo-${k}{animation:${p}-h${k} 7.5s ease-out infinite}`;
  }
  css += `@media (prefers-reduced-motion:reduce){.${p} .line{animation:none;stroke-dashoffset:0}`;
  for (const k of visited.keys()) css += `.${p} .dot-${k}{animation:none;fill:#75D8FF;transform:scale(1.3)}.${p} .halo-${k}{animation:none;opacity:0}`;
  css += `}`;
} else {
  for (const k of visited.keys()) css += `.${p} .dot-${k}{fill:#75D8FF;transform:scale(1.3)}`;
}
const dots: { r: number; c: number; x: number; y: number }[] = [];
for (let r = 0; r < 5; r++) for (let c = 0; c < 5; c++) dots.push({ r, c, x: PAD + c * GAP, y: PAD + r * GAP });
---
<svg class={`pattern-grid ${p}`} width={size} height={size} viewBox={`0 0 ${VB} ${VB}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false">
  <defs>
    <linearGradient id={`${p}-g`} x1="0" y1="0" x2={VB} y2={VB} gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#4F8CFF" /><stop offset="1" stop-color="#75D8FF" />
    </linearGradient>
    <filter id={`${p}-glow`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="7" /></filter>
  </defs>
  {dots.map((o) => <circle class="base" cx={o.x} cy={o.y} r="7" fill="#2a3a57" />)}
  <path class="line glow" d={d} pathLength="1" fill="none" stroke={`url(#${p}-g)`} stroke-width="12" stroke-linecap="round" stroke-linejoin="round" filter={`url(#${p}-glow)`} opacity=".75" />
  <path class="line" d={d} pathLength="1" fill="none" stroke={`url(#${p}-g)`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  {[...visited.keys()].map((k) => { const [r, c] = k.split('-').map(Number); const [x, y] = pt([r, c]); return (
    <>
      <circle class={`halo halo-${k}`} cx={x} cy={y} r="9" fill="none" stroke="#75D8FF" stroke-width="2" opacity="0" />
      <circle class={`dot dot-${k}`} cx={x} cy={y} r="7" fill="#2a3a57" />
    </>
  ); })}
</svg>
<style is:inline set:html={css}></style>
