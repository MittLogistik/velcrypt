---
import { getPageById, type Page } from '../lib/content';
import { STATIC_ROUTES } from '../i18n/static-routes.mjs';
import { pathFor } from '../i18n/registry.mjs';

interface Props { ids: string[]; locale: string; heading?: string }
const { ids, locale, heading = 'Related reading' } = Astro.props;
const SECTION_LABEL: Record<string, string> = { pages: 'Velcrypt', features: 'Feature', guides: 'Guide', useCases: 'Use case', compare: 'Comparison', tools: 'Free tool' };
const items: { title: string; summary: string; href: string; label: string }[] = [];
for (const id of ids) {
  const p: Page | undefined = await getPageById(id, locale);
  if (p) {
    items.push({ title: p.data.navTitle, summary: p.data.summary ?? p.data.description, href: p.path, label: SECTION_LABEL[p.collection] });
    continue;
  }
  const s = STATIC_ROUTES.find((r) => r.id === id);
  if (s) { items.push({ title: s.title, summary: s.description, href: pathFor(id, locale), label: 'Overview' }); continue; }
  throw new Error(`Related: unknown pageId "${id}"`);
}
---
{items.length > 0 && (
  <section class="related" aria-labelledby="related-title">
    <h2 id="related-title">{heading}</h2>
    <div class="grid grid-3">
      {items.map((it) => (
        <a class="card link-card" href={it.href}>
          <span class="lbl">{it.label}</span>
          <h3>{it.title}</h3>
          <p>{it.summary}</p>
        </a>
      ))}
    </div>
  </section>
)}
<style>
  .related { margin-top: 64px; }
  .lbl { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cyan); margin-bottom: 8px; font-weight: 600; }
</style>
