---
import HubLayout from '../../layouts/HubLayout.astro';
import { getPages, GUIDE_CATEGORIES } from '../../lib/content';
const guides = await getPages('guides');
const INTRO: Record<string, string> = {
  hiding: 'Step-by-step help with the options built into iOS, and where they stop.',
  apple: 'What Apple’s Hidden album, iCloud and photo permissions actually do with your pictures.',
  choosing: 'How to judge a photo vault app before you trust it with anything.',
  security: 'Encryption, patterns and plausible deniability, explained without jargon.',
  practical: 'Clean-up, metadata, travel and other real-world privacy tasks.',
};
const groups = Object.keys(GUIDE_CATEGORIES).map((c) => ({ title: GUIDE_CATEGORIES[c], intro: INTRO[c], pages: guides.filter((g) => g.data.category === c) }));
---
<HubLayout
  pageId="guides"
  title="iPhone Photo Privacy Guides: Hide, Lock, Encrypt"
  description="Practical, up-to-date guides to hiding, locking and encrypting photos, videos and documents on iPhone, including what iOS does and doesn't protect."
  h1="iPhone photo privacy guides"
  crumb="Guides"
  answer="These guides explain how to keep photos, videos and documents private on iPhone: what the built-in Hidden album and iCloud settings really do, how to choose a vault app, and how encryption and patterns protect you."
  facts={[
    'Hiding a photo in iOS removes it from the main grid but does not encrypt it.',
    'With iCloud Photos on, hidden photos sync to iCloud like any other photo.',
    'Only Advanced Data Protection makes iCloud Photos end-to-end encrypted.',
    'An encrypted vault protects files even from someone who knows your passcode.',
    `${guides.length} guides, written for iOS 18 and iOS 26.`,
  ]}
  groups={groups}
  og="/og/guides.png"
  ct="guides_hub"
/>
