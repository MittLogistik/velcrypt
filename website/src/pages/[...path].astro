---
/**
 * Single router for every page in every active locale:
 *  - home + section hubs (data-driven, copy in src/i18n/copy/<locale>.ts)
 *  - every Markdown entry at its localized URL (see src/i18n/registry.mjs)
 *  - localized 404 pages (/<locale>/404/ → copied to /<locale>/404.html after build)
 * The English 404 lives in src/pages/404.astro.
 */
import HomeView from '../views/HomeView.astro';
import HubView from '../views/HubView.astro';
import EntryView from '../views/EntryView.astro';
import NotFoundView from '../views/NotFoundView.astro';
import { getAllPages, type CollectionName } from '../lib/content';
import { STATIC_ROUTES } from '../i18n/static-routes.mjs';
import { ACTIVE_LOCALES, DEFAULT_LOCALE } from '../i18n/locales.mjs';

export async function getStaticPaths() {
  const clean = (p: string) => p.replace(/^\/|\/$/g, '') || undefined;
  const out: { params: { path: string | undefined }; props: Record<string, unknown> }[] = [];
  for (const r of STATIC_ROUTES) {
    for (const [locale, p] of Object.entries(r.paths)) {
      out.push({ params: { path: clean(p) }, props: { kind: r.kind, locale, pageId: r.id, collection: r.collection } });
    }
  }
  for (const page of await getAllPages()) out.push({ params: { path: clean(page.path) }, props: { kind: 'entry', page } });
  for (const l of ACTIVE_LOCALES) {
    if (l.code === DEFAULT_LOCALE) continue;
    out.push({ params: { path: `${l.prefix.slice(1)}/404` }, props: { kind: '404', locale: l.code } });
  }
  return out;
}

const props = Astro.props as { kind: string; locale: string; pageId: string; collection?: string; page?: unknown };
---
{props.kind === 'home' && <HomeView locale={props.locale} />}
{props.kind === 'hub' && <HubView locale={props.locale} pageId={props.pageId} collection={props.collection as Exclude<CollectionName, 'pages'>} />}
{props.kind === 'entry' && <EntryView page={props.page as any} />}
{props.kind === '404' && <NotFoundView locale={props.locale} />}
