---
import HubLayout from '../../layouts/HubLayout.astro';
import { getPages } from '../../lib/content';
const items = await getPages('tools');
---
<HubLayout
  pageId="tools"
  title="Free Privacy Tools: EXIF Remover, Pattern Checker"
  description="Free tools that run entirely in your browser: view and strip photo metadata such as GPS location, and estimate how strong an unlock pattern is."
  h1="Free privacy tools"
  crumb="Free tools"
  answer="Two free tools that run entirely in your browser with nothing uploaded: a photo metadata remover that shows and strips EXIF data such as GPS location, and a pattern strength checker for 5×5 unlock patterns."
  facts={[
    'Both tools work offline once the page has loaded.',
    'No files, patterns or results leave your device.',
    'No sign-up, no tracking, no cost.',
  ]}
  groups={[{ pages: items }]}
  og="/og/tools.png"
  ct="tools_hub"
/>
