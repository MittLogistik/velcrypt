---
import HubLayout from '../../layouts/HubLayout.astro';
import { getPages } from '../../lib/content';
const features = await getPages('features');
const core = features.filter((p) => ['pattern-lock', 'hidden-vaults', 'duress-pattern', 'encryption', 'offline-no-account'].includes(p.data.pageId));
const rest = features.filter((p) => !core.includes(p));
---
<HubLayout
  pageId="features"
  title="Velcrypt Features: Pattern Vaults, Encryption, Privacy"
  description="Everything Velcrypt does: pattern unlock on a 5×5 grid, separate hidden vaults, AES-256-GCM encryption, no account, auto-lock and private albums."
  h1="Velcrypt features"
  crumb="Features"
  answer="Velcrypt is an iPhone vault where each pattern you draw on a 5×5 grid opens its own encrypted vault for photos, videos and documents, with no account and nothing uploaded."
  facts={[
    'Unlock by drawing a pattern through at least 6 dots with at least one turn.',
    'Each pattern opens a separate vault. There is no list of vaults.',
    'Files are encrypted with AES-256-GCM, with keys derived on the device.',
    'No account, no servers, no uploads, no Face ID by design.',
    'Duress pattern is a planned Premium feature (coming soon).',
  ]}
  groups={[
    { title: 'How your vaults are protected', intro: 'The unlock model and the cryptography behind it.', pages: core },
    { title: 'What you can keep inside', intro: 'Bring in photos, videos and documents, then organise them privately.', pages: rest },
  ]}
  faq={[
    { q: 'Does Velcrypt use Face ID?', a: 'No. Velcrypt deliberately has no Face ID or Touch ID unlock, because a face or finger can be used without your consent. The pattern exists only in your memory.' },
    { q: 'How many vaults can I create?', a: 'Every distinct pattern opens its own vault. Exact limits for the free version are not final yet; more vaults are one of the planned Premium items.' },
    { q: 'Does Velcrypt upload my photos anywhere?', a: 'No. Velcrypt has no account and no servers. Vault content is encrypted and stays on your iPhone.' },
  ]}
  og="/og/features.png"
  ct="features_hub"
/>
