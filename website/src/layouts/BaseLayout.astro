---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, SITE_NAME } from '../config/site';
import { getLocale, DEFAULT_LOCALE } from '../i18n/locales.mjs';
import { alternatesFor } from '../i18n/registry.mjs';
import { t } from '../i18n/ui';
import { THEME_INIT } from '../lib/theme';

interface Props {
  title: string;
  description: string;
  pageId: string;
  locale?: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object;
  noindex?: boolean;
  navCurrent?: string;
  published?: string;
  modified?: string;
}
const { title, description, pageId, locale = DEFAULT_LOCALE, path, ogImage = '/og/default.png', ogType = 'website', jsonLd, noindex = false, navCurrent, published, modified } = Astro.props;
const loc = getLocale(locale);
const canonical = new URL(path, SITE_URL).toString();
const alternates = noindex ? [] : alternatesFor(pageId);
const xDefault = alternates.find((a) => a.locale === DEFAULT_LOCALE);
const ogUrl = new URL(ogImage, SITE_URL).toString();
if (title.length > 60) console.warn(`[seo] title > 60 chars on ${path}: ${title}`);
if (description.length > 155) console.warn(`[seo] description > 155 chars on ${path}`);
---
<!doctype html>
<html lang={loc.hreflang} dir={loc.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {alternates.length > 0 && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.path, SITE_URL).toString()} />)}
    {alternates.length > 0 && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.path, SITE_URL).toString()} />}
    <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F8FC" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline set:html={THEME_INIT}></script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: ${title}`} />
    <meta property="og:locale" content={loc.ogLocale} />
    {loc.code !== 'en' && <meta property="og:locale:alternate" content="en_US" />}
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="alternate" type="text/plain" title="LLM index" href="/llms.txt" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skip')}</a>
    <Header locale={locale} pageId={pageId} current={navCurrent} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} pageId={pageId} />
  </body>
</html>
